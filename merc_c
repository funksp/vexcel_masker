        Q3["How much would MERC move?<br/>Option A table or Option B calls"]
        SIM["Simulate 100,000<br/>possible true houses"]
        Q1 --> SIM
        Q2 --> SIM
        Q3 --> SIM
    end

    ENG["Ingredient 2 · Engine uncertainty<br/>Verisk range as a spread"]
    NBR["Ingredient 3 · Neighborhood check<br/>cost per sq ft vs. similar homes"]

    SIM --> CONF["Confidence C<br/>chance MERC is in tolerance"]
    ENG --> CONF
    CONF --> BASE["Base tier"]
    BASE --> FINAL["Final tier<br/>+ main driver"]
    NBR -->|can only lower| FINAL

    classDef ingredient fill:#F1F5F9,stroke:#94A3B8,color:#0F172A
