## Appendix C: Reference code

A minimal implementation of every calculation in this document. Running it reproduces the worked example.

```python
import numpy as np
from scipy.stats import norm


def engine_spread(low, high, z=1.645):
    """Verisk's range as a log-scale spread. z = 1.645 for a 90% range, 1.96 for 95%."""
    return np.log(high / low) / (2 * z)


def merc_confidence(not_asked, sigma_v, tol_under=0.10, tol_over=0.15,
                    n_draws=100_000, seed=7):
    """
    Chance that the final MERC is within tolerance of the true rebuild cost.

    not_asked: one dict per attribute the member was NOT asked about
        p_correct : confidence from the attribute model (step 3)
        impacts   : change in log-MERC for each 'if wrong' value
        weights   : how often each 'if wrong' value occurs (sums to 1)
    sigma_v: engine spread from engine_spread()
    """
    rng = np.random.default_rng(seed)
    D = np.zeros(n_draws)                                   # leftover attribute error
    for a in not_asked:
        wrong = rng.random(n_draws) > a["p_correct"]        # weighted coin flip
        pick = rng.choice(len(a["impacts"]), size=n_draws, p=a["weights"])
        D += wrong * np.asarray(a["impacts"])[pick]         # add the impact if wrong
    in_tol = norm.cdf((tol_under - D) / sigma_v) - norm.cdf((-tol_over - D) / sigma_v)
    return in_tol.mean()


def main_driver(not_asked, sigma_v, **kw):
    """Lift in C from treating each not-asked attribute as known."""
    base = merc_confidence(not_asked, sigma_v, **kw)
    lifts = {}
    for i, a in enumerate(not_asked):
        known = [dict(b, p_correct=1.0) if j == i else b for j, b in enumerate(not_asked)]
        lifts[a["name"]] = merc_confidence(known, sigma_v, **kw) - base
    return max(lifts, key=lifts.get), lifts


def neighborhood_reference(cells, k=25):
    """
    Blend the median and MAD of log $/sqft down the H3 hierarchy, within one size band.
    cells: ordered state, r4, r5, r6, r7; each has n, median and mad on the log scale.
    """
    mu, log_mad = cells[0]["median"], np.log(cells[0]["mad"])
    for c in cells[1:]:
        w = c["n"] / (c["n"] + k)
        mu = w * c["median"] + (1 - w) * mu
        log_mad = w * np.log(c["mad"]) + (1 - w) * log_mad
    return mu, 1.4826 * np.exp(log_mad)


def tier(c, z, high=0.90, low=0.70):
    """Base tier from C, then the neighborhood override, which can only lower it."""
    level = 2 if c >= high else 1 if c >= low else 0
    if abs(z) > 3:
        level = 0
    elif abs(z) > 2:
        level = max(level - 1, 0)
    return ["Low", "Medium", "High"][level]


# ---- Worked example ----------------------------------------------------------
sigma_v = engine_spread(341_000, 405_000)
e_sqft = 0.85                                               # elasticity from the table
not_asked = [
    {"name": "square footage", "p_correct": 0.86,
     "impacts": [e_sqft * np.log(1.18), e_sqft * np.log(0.88)], "weights": [0.55, 0.45]},
    {"name": "stories",      "p_correct": 0.93, "impacts": [-0.06],       "weights": [1.0]},
    {"name": "construction", "p_correct": 0.95, "impacts": [0.05],        "weights": [1.0]},
    {"name": "roof",         "p_correct": 0.96, "impacts": [0.02],        "weights": [1.0]},
    {"name": "year built",   "p_correct": 0.94, "impacts": [0.01, -0.01], "weights": [0.5, 0.5]},
]
C = merc_confidence(not_asked, sigma_v)

cells = [  # size band 1,800-2,500 sq ft
    {"n": 48_000, "median": np.log(168), "mad": 0.110},    # state
    {"n": 2_400,  "median": np.log(176), "mad": 0.090},    # r4
    {"n": 310,    "median": np.log(179), "mad": 0.080},    # r5
    {"n": 42,     "median": np.log(184), "mad": 0.070},    # r6
    {"n": 9,      "median": np.log(190), "mad": 0.050},    # r7
]
mu, sd = neighborhood_reference(cells)
z = (np.log(372_000 / 2_150) - mu) / sd

driver, lifts = main_driver(not_asked, sigma_v)
print(f"C = {C:.3f}   z = {z:.2f}   tier = {tier(C, z)}   main driver = {driver}")
# C = 0.893   z = -0.63   tier = Medium   main driver = square footage
```
