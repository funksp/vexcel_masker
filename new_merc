## Appendix B: Reference code

A minimal implementation of everything in this document. The last block reproduces Home 1. For building the neighborhood reference from the book (`prepare_book` and `cell_stats`), reuse the code from the interim method's appendix.

```python
import numpy as np
import pandas as pd
from scipy.stats import norm

# ---- Parameters: illustrative starting values (section 8) ---------------------
TOL_UNDER, TOL_OVER = 0.10, 0.15      # MERC may be ~10% too low or ~15% too high
RANGE_Z = 1.645                       # Verisk ranges assumed to be 90% ranges
SIGMA_PCS = {5: 0.02, 4: 0.035, 3: 0.05, 2: 0.08, 1: 0.12}   # leftover data risk by PCS
P_MEMBER_WRONG = 0.10                 # chance the member's changes are wrong
HIGH_CUT, LOW_CUT = 0.90, 0.70        # tier cutoffs on confidence
MIN_NEARBY, EXTREME_Z = 30, 3.0       # guardrails
MAD_FLOOR = 0.02


# ---- Signal 4: H3 neighborhood reference (built from the book) ----------------
def blend_neighborhood(cells, k=25):
    """Credibility-blend median and MAD of log $/sqft from the state down to r7."""
    center, log_mad = cells[0]["median"], np.log(max(cells[0]["mad"], MAD_FLOOR))
    for c in cells[1:]:
        w = c["n"] / (c["n"] + k)
        w_spread = w if c["n"] >= 3 else 0.0
        center = w * c["median"] + (1 - w) * center
        log_mad = w_spread * np.log(max(c["mad"], MAD_FLOOR)) + (1 - w_spread) * log_mad
    n_r5 = next((c["n"] for c in cells if c["level"] == "h3_r5"), 0)
    return {"center": center, "spread": 1.4826 * np.exp(log_mad), "n_r5": n_r5}


# ---- Signals 1-3 plus the neighborhood, for one version of the house ----------
def spread_from_range(low, high):
    """A Verisk range as a log-scale standard deviation."""
    return np.log(high / low) / (2 * RANGE_Z)


def chance_in_tolerance(offset, sd):
    """Chance the quote is within tolerance when the truth is centered `offset` (log) away."""
    return norm.cdf((TOL_UNDER - offset) / sd) - norm.cdf((-TOL_OVER - offset) / sd)


def one_version(est, quote_merc, pcs, nbhd, use_pcs=True, use_nbhd=True):
    s_engine = spread_from_range(est["low"], est["high"])             # signal 1 or 2
    s_data = SIGMA_PCS[pcs] if use_pcs else 0.0                       # signal 3
    s_total = np.hypot(s_engine, s_data)
    n_est = np.exp(nbhd["center"]) * est["sqft"]                      # signal 4
    pull = s_total**2 / (s_total**2 + nbhd["spread"]**2) if use_nbhd else 0.0
    offset = np.log(est["merc"] / quote_merc) + pull * np.log(n_est / est["merc"])
    return {"s_engine": s_engine, "s_data": s_data, "s_total": s_total, "n_est": n_est,
            "pull": pull, "offset": offset, "c": chance_in_tolerance(offset, s_total)}


def merc_confidence(prefill, final, pcs, nbhd, nbhd_prefill=None,
                    use_pcs=True, use_nbhd=True, use_prefill=True):
    """Weighted average of 'member was right' and 'member was wrong'."""
    changed = not np.isclose(prefill["merc"], final["merc"])
    q = P_MEMBER_WRONG if (changed and use_prefill) else 0.0
    right = one_version(final, final["merc"], pcs, nbhd, use_pcs, use_nbhd)
    wrong = one_version(prefill, final["merc"], pcs, nbhd_prefill or nbhd, use_pcs, use_nbhd)
    return (1 - q) * right["c"] + q * wrong["c"], right, wrong


# ---- Tier, guardrails and main driver -----------------------------------------
STEPS = [
    ("Final MERC range", dict(use_pcs=False, use_nbhd=False, use_prefill=False)),
    ("Property Confidence Score", dict(use_nbhd=False, use_prefill=False)),
    ("Neighborhood estimate", dict(use_prefill=False)),
    ("Prefill vs. final", dict()),
]


def score_quote(prefill, final, pcs, nbhd, nbhd_prefill=None):
    waterfall = [(label, merc_confidence(prefill, final, pcs, nbhd, nbhd_prefill, **kw)[0])
                 for label, kw in STEPS]
    c = waterfall[-1][1]
    t = "High" if c >= HIGH_CUT else "Medium" if c >= LOW_CUT else "Low"
    z = (np.log(final["merc"] / final["sqft"]) - nbhd["center"]) / nbhd["spread"]
    flags = []
    if nbhd["n_r5"] < MIN_NEARBY:
        flags.append("few comparable homes nearby")
    if abs(z) > EXTREME_Z:
        flags.append("far outside the neighborhood's $/sqft")
    if flags and t == "High":
        t = "Medium"
    before = [1.0] + [v for _, v in waterfall[:-1]]
    drops = {label: b - v for (label, v), b in zip(waterfall, before)}
    return {"confidence": c, "tier": t, "z": z, "flags": flags,
            "main_driver": max(drops, key=drops.get), "waterfall": waterfall}


# ---- Calibration: leftover data risk by PCS (section 8) -----------------------
def calibrate_sigma_pcs(quotes):
    """quotes: prefill_merc, final_merc, pcs, audit (True = every attribute asked)."""
    q = quotes.assign(shift=np.log(quotes["final_merc"] / quotes["prefill_merc"]))
    q = q[q["shift"].abs() < np.log(3)]                       # drop data errors (3x moves)
    var = q.groupby(["pcs", "audit"])["shift"].var().unstack()
    sigma = np.sqrt((var[True] - var[False]).clip(lower=0))
    return sigma.sort_index(ascending=False).cummax()         # lower PCS never gets less risk


# ---- Worked example -----------------------------------------------------------
nbhd = blend_neighborhood([  # size band 2 (1,800-2,500 sq ft)
    {"level": "state", "n": 48_000, "median": np.log(168), "mad": 0.110},
    {"level": "h3_r4", "n": 2_400,  "median": np.log(176), "mad": 0.090},
    {"level": "h3_r5", "n": 310,    "median": np.log(179), "mad": 0.080},
    {"level": "h3_r6", "n": 42,     "median": np.log(184), "mad": 0.070},
    {"level": "h3_r7", "n": 9,      "median": np.log(190), "mad": 0.050},
])
prefill = {"merc": 335_000, "low": 306_000, "high": 367_000, "sqft": 1_950}
final = {"merc": 372_000, "low": 341_000, "high": 405_000, "sqft": 2_150}
result = score_quote(prefill, final, pcs=3, nbhd=nbhd)
print(f"{result['tier']} ({result['confidence']:.3f}), main driver: {result['main_driver']}")
# Medium (0.848), main driver: Property Confidence Score
```
